---
import { Image } from 'astro:assets';
import { portfolioItems } from '../../data/portfolio';
import { buildWhatsappLink } from '../../lib/whatsapp';

const portfolioLink = buildWhatsappLink('portfolio');
---

<section class="py-section-gap px-margin-mobile md:px-margin-desktop max-w-container mx-auto" id="portfolio">
  <!-- Header -->
  <div class="text-center mb-12">
    <h1 class="font-montserrat font-black text-display-xl-mobile md:text-display-xl text-on-surface mb-4">
      Galeri <span class="text-primary">Portofolio</span>
    </h1>
    <p class="text-body-lg text-on-surface-variant font-inter font-light max-w-2xl mx-auto">
      Lihat hasil pengerjaan nano ceramic coating kami pada berbagai jenis kendaraan. Kualitas yang berbicara.
    </p>
  </div>

  

  <!-- Gallery Carousel -->
  <div class="relative" id="gallery-section">
    <!-- Carousel Container -->
    <div
      class="flex gap-6 overflow-x-auto snap-x snap-mandatory pb-4 scrollbar-hide"
      id="gallery-carousel"
      style="scroll-behavior: smooth; -ms-overflow-style: none; scrollbar-width: none;"
    >
      {portfolioItems.map((item) => (
        <div
          class="snap-center shrink-0 w-80 md:w-96 group"
          data-item-id={item.id}
        >
          <div class="bg-card border border-card-border rounded-xl overflow-hidden hover:border-primary transition-all duration-300 hover:scale-[1.02]">
            {/* Media */}
            <div class="relative aspect-[2/3] overflow-hidden">
              <Image
                src={item.src as any}
                alt={item.alt}
                width={800}
                height={1200}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
              {item.type === 'video' && (
                <div class="absolute inset-0 flex items-center justify-center bg-black/30">
                  <div class="w-14 h-14 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="white">
                      <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                  </div>
                </div>
              )}
            </div>

            {/* Caption */}
            <div class="p-4">
              <p class="text-body-sm text-on-surface font-inter font-medium m-0">
                {item.caption}
              </p>
              <p class="text-label-bold text-text-dim font-inter mt-1 m-0 uppercase tracking-wider">
                {item.branch === 'sukoharjo' ? 'Sukoharjo (Pusat)' : 'Karanganyar'}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Navigation Arrows -->
    <button
      type="button"
      class="hidden md:flex absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 w-12 h-12 rounded-full items-center justify-center shadow-lg z-10 cursor-pointer border-none transition-all hover:scale-110"
      id="gallery-prev"
      style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(8px); border: 1px solid rgba(0,0,0,0.1);"
      aria-label="Sebelumnya"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-on-surface">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <button
      type="button"
      class="hidden md:flex absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 w-12 h-12 rounded-full items-center justify-center shadow-lg z-10 cursor-pointer border-none transition-all hover:scale-110"
      id="gallery-next"
      style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(8px); border: 1px solid rgba(0,0,0,0.1);"
      aria-label="Berikutnya"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-on-surface">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>



  <!-- CTA -->
  <div class="text-center mt-16">
    <div class="glass-panel inner-glow rounded-xl p-8 max-w-lg mx-auto border border-primary/20">
      <h3 class="font-montserrat font-bold text-headline-md text-on-surface mb-3">
        Tertarik? <span class="text-secondary">Booking Sekarang</span>
      </h3>
      <p class="text-body-sm text-on-surface-variant font-inter mb-6">
        Dapatkan hasil coating premium untuk mobil Anda. Konsultasi gratis!
      </p>
      <a
        href={portfolioLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block w-full max-w-sm bg-secondary text-on-secondary font-montserrat font-bold text-lg py-4 rounded-lg hover:brightness-110 transition-all uppercase no-underline text-center"
      >
        Booking via WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const carousel = document.getElementById('gallery-carousel');
  const prevBtn = document.getElementById('gallery-prev');
  const nextBtn = document.getElementById('gallery-next');

  if (carousel) {
    const scrollAmount = 400;

    prevBtn?.addEventListener('click', () => {
      if (carousel.scrollLeft <= 10) {
        carousel.scrollTo({ left: carousel.scrollWidth, behavior: 'smooth' });
      } else {
        carousel.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      }
    });

    nextBtn?.addEventListener('click', () => {
      if (Math.ceil(carousel.scrollLeft + carousel.clientWidth) >= carousel.scrollWidth - 10) {
        carousel.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        carousel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      }
    });
  }


</script>
